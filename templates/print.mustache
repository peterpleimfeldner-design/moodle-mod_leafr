{{!
    @template mod_leafr/print

    Printable list of the current user's bookmarks, reachable from the bookmarks sidebar tab.
    Deliberately plain HTML (no reader JavaScript needed), so it always renders and prints
    cleanly; the browser's own "Print" / "Save as PDF" handles the output format.

    Context variables required for this template:
    * activityname - Name of the Leafr activity
    * username - Full name of the current user
    * exportdate - Formatted date and time of the export
    * empty - Whether there are no bookmarks
    * bookmarks - Array of {pagelabel, note}, ordered by page

    Example context (json):
    {
        "activityname": "Handbook",
        "username": "Student One",
        "exportdate": "23 September 2026, 10:00",
        "empty": false,
        "bookmarks": [
            {"pagelabel": "Page 3", "note": "Remember this for the exam"},
            {"pagelabel": "Page 9", "note": ""}
        ]
    }
}}
<div class="leafr-print">
    <div class="leafr-print-actions">
        <button type="button" class="btn btn-primary" onclick="window.print()">{{#str}}bookmark_print, mod_leafr{{/str}}</button>
    </div>
    <h1 class="leafr-print-title">{{activityname}}</h1>
    <p class="leafr-print-meta">{{username}} &middot; {{exportdate}}</p>
    {{#empty}}
    <p>{{#str}}bookmark_empty, mod_leafr{{/str}}</p>
    {{/empty}}
    {{^empty}}
    <ol class="leafr-print-list">
        {{#bookmarks}}
        <li>
            <strong>{{pagelabel}}</strong>
            {{#note}}<p>{{note}}</p>{{/note}}
        </li>
        {{/bookmarks}}
    </ol>
    {{/empty}}
</div>
