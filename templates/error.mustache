{{!
    @template mod_leafr/error

    Shown instead of the reader when the activity has no PDF file.

    Context variables required for this template:
    * message - Message to display

    Example context (json):
    {
        "message": "No PDF file has been added to this activity yet."
    }
}}
<div class="leafr-nofile alert alert-info" role="status">
    {{message}}
</div>
