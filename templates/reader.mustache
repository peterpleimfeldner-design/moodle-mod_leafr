{{!
    Template: mod_leafr/reader
    Renders the main Leafr flipbook reader container.

    @copyright 2026 Leafr
    @license   GNU GPL v3 or later
}}
<div id="leafr-reader-container" class="leafr-reader" role="main" aria-label="{{name}} – PDF Flipbook">

    {{! ARIA live region for screen reader announcements }}
    <div id="leafr-aria-live" class="sr-only" aria-live="polite" aria-atomic="true"></div>

    {{! Loading skeleton }}
    <div id="leafr-skeleton" class="leafr-skeleton" aria-hidden="true">
        <div class="leafr-skeleton-page leafr-skeleton-page--left"></div>
        <div class="leafr-skeleton-page leafr-skeleton-page--right"></div>
        <div class="leafr-skeleton-spinner" role="status">
            <span class="sr-only">{{#str}}loading, leafr{{/str}}</span>
        </div>
    </div>

    {{! Error state }}
    <div id="leafr-error" class="leafr-error-state" style="display:none;" role="alert">
        <svg class="leafr-error-icon" aria-hidden="true" width="48" height="48" viewBox="0 0 256 256">
            <path fill="currentColor" d="M236.8 188.09L149.35 36.22a24.76 24.76 0 0 0-42.7 0L19.2 188.09a23.51 23.51 0 0 0 0 23.72A24.35 24.35 0 0 0 40.55 224h174.9a24.35 24.35 0 0 0 21.33-12.19a23.51 23.51 0 0 0 .02-23.72ZM120 104a8 8 0 0 1 16 0v40a8 8 0 0 1-16 0Zm8 88a12 12 0 1 1 12-12a12 12 0 0 1-12 12Z"/>
        </svg>
        <p class="leafr-error-message"></p>
        <a id="leafr-error-download" class="btn btn-secondary leafr-error-download" style="display:none;" aria-label="PDF herunterladen">
            {{#str}}pdffile, leafr{{/str}} herunterladen
        </a>
        <button class="btn btn-primary leafr-error-retry" onclick="window.location.reload()">
            Seite neu laden
        </button>
    </div>

    {{! Main reader layout }}
    <div class="leafr-layout">

        {{! TOC Panel (left drawer) }}
        {{#showtoc}}
        <nav id="leafr-toc-panel" class="leafr-toc-panel" aria-label="{{#str}}toc_title, leafr{{/str}}" aria-hidden="true">
            <div class="leafr-toc-header">
                <h2 class="leafr-toc-title">{{#str}}toc_title, leafr{{/str}}</h2>
                <button class="leafr-toc-close" aria-label="Inhaltsverzeichnis schließen" onclick="document.getElementById('leafr-toc-panel').classList.remove('is-open');this.closest('[aria-hidden]').setAttribute('aria-hidden','true');">
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 256 256">
                        <path fill="currentColor" d="M205.66 194.34a8 8 0 0 1-11.32 11.32L128 139.31l-66.34 66.35a8 8 0 0 1-11.32-11.32L116.69 128L50.34 61.66a8 8 0 0 1 11.32-11.32L128 116.69l66.34-66.35a8 8 0 0 1 11.32 11.32L139.31 128Z"/>
                    </svg>
                </button>
            </div>
            <ul class="leafr-toc-list" role="list">
                {{! Populated dynamically by reader.js }}
            </ul>
            <div class="leafr-toc-bookmarks">
                <h3 class="leafr-toc-bookmark-title">Lesezeichen</h3>
                <ul id="leafr-bookmark-list" class="leafr-bookmark-list" role="list">
                    {{! Populated dynamically by bookmarks.js }}
                </ul>
            </div>
        </nav>
        {{/showtoc}}

        {{! Flipbook area }}
        <div class="leafr-flipbook-area">
            <div id="leafr-flipbook" class="leafr-flipbook" aria-label="PDF Flipbook Inhalt">
                {{! StPageFlip canvas pages injected here by flipbook.js }}
            </div>

            {{! Simple view (accessible scrollable) }}
            <div id="leafr-simple-view" class="leafr-simple-view" style="display:none;" aria-label="PDF Inhalt – einfache Ansicht">
                {{! Pages rendered here by reader.js initSimpleView }}
            </div>
        </div>

        {{! Pro: Bookmark panel (right) }}
        {{#proavailable}}
        <aside class="leafr-bookmark-panel" aria-label="Lesezeichen">
            <button id="leafr-bookmark-add" class="leafr-bookmark-add-btn btn btn-sm btn-outline-secondary" aria-label="{{#str}}bookmark_add, leafr{{/str}}">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 256 256">
                    <path fill="currentColor" d="M184 32H72a16 16 0 0 0-16 16v176a8 8 0 0 0 12.65 6.51L128 193.83l59.35 36.68A8 8 0 0 0 200 224V48a16 16 0 0 0-16-16Zm0 177.57l-51.35-31.72a8 8 0 0 0-9.3 0L72 209.57V48h112Z"/>
                </svg>
                {{#str}}bookmark_add, leafr{{/str}}
            </button>
        </aside>
        {{/proavailable}}
    </div>

    {{! Bottom Toolbar — always visible }}
    <nav id="leafr-toolbar" class="leafr-toolbar" role="navigation" aria-label="PDF-Navigation">

        {{! Mobile: condensed layout }}
        <div class="leafr-toolbar-inner">

            {{! Left controls }}
            <div class="leafr-toolbar-group leafr-toolbar-group--left">
                <button id="leafr-btn-first" class="leafr-btn leafr-btn--icon" aria-label="Erste Seite" title="Erste Seite">
                    {{! SkipBack icon }}
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 256 256">
                        <path fill="currentColor" d="M205.66 205.66a8 8 0 0 1-11.32 0l-80-80a8 8 0 0 1 0-11.32l80-80a8 8 0 0 1 11.32 11.32L131.31 128l74.35 74.34a8 8 0 0 1 0 11.32ZM48 40a8 8 0 0 0-8 8v160a8 8 0 0 0 16 0V48a8 8 0 0 0-8-8Z"/>
                    </svg>
                </button>
                <button id="leafr-btn-prev" class="leafr-btn leafr-btn--icon" aria-label="Vorherige Seite" title="Vorherige Seite">
                    {{! CaretLeft icon }}
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 256 256">
                        <path fill="currentColor" d="M165.66 202.34a8 8 0 0 1-11.32 11.32l-80-80a8 8 0 0 1 0-11.32l80-80a8 8 0 0 1 11.32 11.32L91.31 128Z"/>
                    </svg>
                </button>
            </div>

            {{! Center: page input + progress bar }}
            <div class="leafr-toolbar-group leafr-toolbar-group--center">
                <div class="leafr-page-indicator">
                    <label for="leafr-page-input" class="sr-only">Zur Seite</label>
                    <input
                        type="number"
                        id="leafr-page-input"
                        class="leafr-page-input"
                        value="1"
                        min="1"
                        aria-label="Zur Seite"
                    />
                    <span class="leafr-page-separator" aria-hidden="true">/</span>
                    <span id="leafr-total-pages" class="leafr-total-pages">—</span>
                </div>
                <div id="leafr-progress-track" class="leafr-progress-track" role="slider" aria-valuemin="1" aria-valuemax="100" aria-valuenow="1" tabindex="0" aria-label="Lesefortschritt">
                    <div id="leafr-progress-fill" class="leafr-progress-fill" style="width:0%"></div>
                </div>
            </div>

            {{! Right controls }}
            <div class="leafr-toolbar-group leafr-toolbar-group--right">
                <button id="leafr-btn-next" class="leafr-btn leafr-btn--icon" aria-label="Nächste Seite" title="Nächste Seite">
                    {{! CaretRight icon }}
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 256 256">
                        <path fill="currentColor" d="M181.66 133.66l-80 80a8 8 0 0 1-11.32-11.32L164.69 128L90.34 53.66a8 8 0 0 1 11.32-11.32l80 80a8 8 0 0 1 0 11.32Z"/>
                    </svg>
                </button>
                <button id="leafr-btn-last" class="leafr-btn leafr-btn--icon" aria-label="Letzte Seite" title="Letzte Seite">
                    {{! SkipForward icon }}
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 256 256">
                        <path fill="currentColor" d="M208 40a8 8 0 0 0-8 8v160a8 8 0 0 0 16 0V48a8 8 0 0 0-8-8ZM50.34 53.66a8 8 0 0 1 11.32-11.32l80 80a8 8 0 0 1 0 11.32l-80 80a8 8 0 0 1-11.32-11.32L124.69 128Z"/>
                    </svg>
                </button>

                {{! TOC toggle }}
                <button id="leafr-btn-toc" class="leafr-btn leafr-btn--icon" aria-label="Inhaltsverzeichnis" title="Inhaltsverzeichnis (T)">
                    {{! List icon }}
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 256 256">
                        <path fill="currentColor" d="M224 128a8 8 0 0 1-8 8H40a8 8 0 0 1 0-16h176a8 8 0 0 1 8 8ZM40 72h176a8 8 0 0 0 0-16H40a8 8 0 0 0 0 16Zm176 112H40a8 8 0 0 0 0 16h176a8 8 0 0 0 0-16Z"/>
                    </svg>
                </button>

                {{! Fullscreen toggle (desktop only) }}
                <button id="leafr-btn-fullscreen" class="leafr-btn leafr-btn--icon leafr-desktop-only" aria-label="Vollbild" aria-pressed="false" title="Vollbild (F)">
                    {{! CornersOut icon }}
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 256 256">
                        <path fill="currentColor" d="M208 32h-48a8 8 0 0 0 0 16h28.69L154.34 82.34a8 8 0 1 0 11.32 11.32L200 59.31V88a8 8 0 0 0 16 0V40a8 8 0 0 0-8-8ZM90.34 160.34L56 194.69V168a8 8 0 0 0-16 0v48a8 8 0 0 0 8 8h48a8 8 0 0 0 0-16H67.31l34.35-34.34a8 8 0 0 0-11.32-11.32ZM200 160a8 8 0 0 0-8 8v26.69l-34.34-34.35a8 8 0 0 0-11.32 11.32L180.69 208H152a8 8 0 0 0 0 16h48a8 8 0 0 0 8-8v-48a8 8 0 0 0-8-8ZM64 40a8 8 0 0 0 0 16h26.69L56.34 90.34a8 8 0 0 0 11.32 11.32L102 67.31V96a8 8 0 0 0 16 0V48a8 8 0 0 0-8-8Z"/>
                    </svg>
                </button>

                {{! Download (if allowed) }}
                <a id="leafr-btn-download" class="leafr-btn leafr-btn--icon" aria-label="PDF herunterladen" title="PDF herunterladen" href="#" role="button">
                    {{! DownloadSimple icon }}
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 256 256">
                        <path fill="currentColor" d="M224 152v56a16 16 0 0 1-16 16H48a16 16 0 0 1-16-16v-56a8 8 0 0 1 16 0v56h160v-56a8 8 0 0 1 16 0Zm-101.66 5.66a8 8 0 0 0 11.32 0l40-40a8 8 0 0 0-11.32-11.32L136 132.69V40a8 8 0 0 0-16 0v92.69L93.66 106.34a8 8 0 0 0-11.32 11.32Z"/>
                    </svg>
                </a>

                {{! Simple view toggle }}
                <button id="leafr-btn-simple" class="leafr-btn leafr-btn--icon" aria-label="{{#str}}simple_view, leafr{{/str}}" title="Einfache Ansicht">
                    {{! Accessibility icon }}
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 256 256">
                        <path fill="currentColor" d="M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24Zm0 192a88 88 0 1 1 88-88a88.1 88.1 0 0 1-88 88Zm56-104a8 8 0 0 1-8 8h-40v56a8 8 0 0 1-16 0v-56H80a8 8 0 0 1 0-16h48V80a8 8 0 0 1 16 0v40Z"/>
                    </svg>
                </button>
            </div>
        </div>
    </nav>

    {{! Resume reading toast (unten-links) }}
    <div id="leafr-resume-toast" class="leafr-toast" style="display:none;" role="dialog" aria-label="Weiterlesen" aria-hidden="true">
        <p class="leafr-toast-message">
            {{#str}}resume_toast, leafr{{/str}}
            <strong class="leafr-toast-page"></strong>
        </p>
        <div class="leafr-toast-actions">
            <button class="leafr-toast-continue btn btn-sm btn-primary">{{#str}}resume_continue, leafr{{/str}}</button>
            <button class="leafr-toast-restart btn btn-sm btn-ghost">{{#str}}resume_restart, leafr{{/str}}</button>
        </div>
    </div>

    {{! Completion notice }}
    <div id="leafr-completion-notice" class="leafr-completion-notice" style="display:none;" aria-hidden="true">
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 256 256">
            <path fill="currentColor" d="M173.66 98.34a8 8 0 0 1 0 11.32l-56 56a8 8 0 0 1-11.32 0l-24-24a8 8 0 0 1 11.32-11.32L112 148.69l50.34-50.35a8 8 0 0 1 11.32 0ZM232 128A104 104 0 1 1 128 24a104.11 104.11 0 0 1 104 104Zm-16 0a88 88 0 1 0-88 88a88.1 88.1 0 0 0 88-88Z"/>
        </svg>
        {{#str}}completion_done, leafr{{/str}}
    </div>

    {{! Bookmark modal (Pro) }}
    <div id="leafr-bookmark-modal" class="leafr-modal" style="display:none;" role="dialog" aria-label="Lesezeichen hinzufügen" aria-hidden="true" aria-modal="true">
        <div class="leafr-modal-content">
            <h2 class="leafr-modal-title">{{#str}}bookmark_add, leafr{{/str}}</h2>
            <div class="leafr-modal-body">
                <label for="leafr-bm-page" class="leafr-label">Seite</label>
                <input type="number" id="leafr-bm-page" class="leafr-input form-control" min="1" readonly>

                <label for="leafr-bm-label" class="leafr-label">Name</label>
                <input type="text" id="leafr-bm-label" class="leafr-input form-control" maxlength="255" placeholder="z.B. Kapitel 3">

                <label for="leafr-bm-note" class="leafr-label">Notiz (optional)</label>
                <textarea id="leafr-bm-note" class="leafr-input form-control" rows="3" maxlength="500" placeholder="Optionale Notiz..."></textarea>
            </div>
            <div class="leafr-modal-footer">
                <button id="leafr-bm-cancel" class="btn btn-secondary">Abbrechen</button>
                <button id="leafr-bm-save"   class="btn btn-primary">Speichern</button>
            </div>
        </div>
    </div>

    {{! Help overlay }}
    <div id="leafr-help-overlay" class="leafr-help-overlay" style="display:none;" role="dialog" aria-label="Tastaturkürzel" aria-hidden="true">
        <div class="leafr-help-content">
            <h2>Tastaturkürzel</h2>
            <dl>
                <dt><kbd>←</kbd> <kbd>Bild↑</kbd></dt><dd>Vorherige Seite</dd>
                <dt><kbd>→</kbd> <kbd>Bild↓</kbd></dt><dd>Nächste Seite</dd>
                <dt><kbd>Pos1</kbd></dt><dd>Erste Seite</dd>
                <dt><kbd>Ende</kbd></dt><dd>Letzte Seite</dd>
                <dt><kbd>T</kbd></dt><dd>Inhaltsverzeichnis öffnen/schließen</dd>
                <dt><kbd>F</kbd></dt><dd>Vollbild umschalten</dd>
                <dt><kbd>Esc</kbd></dt><dd>Vollbild beenden / Dialog schließen</dd>
                <dt><kbd>?</kbd></dt><dd>Diese Hilfe anzeigen/ausblenden</dd>
            </dl>
            <button class="btn btn-primary" onclick="document.getElementById('leafr-help-overlay').style.display='none'">Schließen</button>
        </div>
    </div>
</div>
