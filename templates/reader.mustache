{{!
    @template mod_leafr/reader

    The Leafr flipbook reader. The document is rendered by the AMD module mod_leafr/reader.

    Context variables required for this template:
    * uniqid - Unique id of the reader element
    * cmid - Course module id
    * readerlabel - Accessible name of the reader
    * fileurl - URL of the PDF file
    * downloadurl - URL to download the PDF, empty if downloading is not allowed
    * startpage - Page to open first
    * initialpage - Configured start page, used by the "start from the beginning" action
    * lastpage - Reading position of the current user, 0 if never opened before
    * seenpages - Pages already seen by the current user, compact ranges (e.g. "1-5,7")
    * bookmarks - Bookmarks of the current user as a JSON array of {page, note}
    * bookmarknotemaxlength - Maximum length of a bookmark note
    * printurl - URL of the printable bookmark list
    * totalpages - Known number of pages, 0 if unknown
    * showtoc - Whether the table of contents is enabled
    * simpleview - "1", "0" or "" (no preference)
    * spreadmode - "auto" (default), "single" or "double": the flipbook's preferred spread
    * completed - Whether the page based completion rule is already fulfilled
    * requiredpages - Pages required by the completion rule, compact ranges (e.g. "1-5,8"), empty if none
    * manualchapters - Manually defined chapters as a JSON array of {title, page}, "[]" if none
    * usemanualchapters - Whether the manual chapter list should always be used instead of the PDF outline

    Example context (json):
    {
        "uniqid": "leafr-reader-1",
        "cmid": 12,
        "readerlabel": "Flipbook: Handbook",
        "fileurl": "https://example.com/pluginfile.php/34/mod_leafr/content/0/handbook.pdf",
        "downloadurl": "https://example.com/pluginfile.php/34/mod_leafr/content/0/handbook.pdf?forcedownload=1",
        "startpage": 1,
        "initialpage": 1,
        "lastpage": 0,
        "seenpages": "",
        "bookmarks": "[]",
        "bookmarknotemaxlength": 500,
        "printurl": "https://example.com/mod/leafr/print.php?id=12",
        "totalpages": 0,
        "showtoc": true,
        "simpleview": "",
        "spreadmode": "auto",
        "completed": false,
        "requiredpages": "",
        "manualchapters": "[]",
        "usemanualchapters": false
    }
}}
<div id="{{uniqid}}" class="leafr-reader" data-region="leafr-reader" role="region"
     aria-label="{{readerlabel}}"
     data-cmid="{{cmid}}" data-fileurl="{{fileurl}}" data-startpage="{{startpage}}" data-initialpage="{{initialpage}}"
     data-lastpage="{{lastpage}}" data-seenpages="{{seenpages}}" data-totalpages="{{totalpages}}"
     data-bookmarks="{{bookmarks}}" data-bookmarknotemaxlength="{{bookmarknotemaxlength}}" data-printurl="{{printurl}}"
     data-simpleview="{{simpleview}}" data-spreadmode="{{spreadmode}}"
     data-completed="{{#completed}}1{{/completed}}{{^completed}}0{{/completed}}"
     data-requiredpages="{{requiredpages}}" data-manualchapters="{{manualchapters}}"
     data-usemanualchapters="{{#usemanualchapters}}1{{/usemanualchapters}}{{^usemanualchapters}}0{{/usemanualchapters}}">

    <div class="leafr-body">
        <aside class="leafr-sidebar" data-region="sidebar" aria-label="{{#str}}sidebar, mod_leafr{{/str}}" hidden>
            <div class="leafr-sidebar-header">
                <div class="leafr-sidebar-tabs" role="tablist" aria-label="{{#str}}sidebar, mod_leafr{{/str}}">
                    <button type="button" class="leafr-sidebar-tab" role="tab" data-tab="thumbs"
                            id="{{uniqid}}-tab-thumbs" aria-controls="{{uniqid}}-panel-thumbs" aria-selected="true"
                            title="{{#str}}tab_thumbnails, mod_leafr{{/str}}">
                        <span class="sr-only">{{#str}}tab_thumbnails, mod_leafr{{/str}}</span>
                        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M216 40H40a16 16 0 0 0-16 16v144a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V56a16 16 0 0 0-16-16Zm0 160H40V56h176v144Z"/></svg>
                    </button>
                    {{#showtoc}}
                    <button type="button" class="leafr-sidebar-tab" role="tab" data-tab="toc"
                            id="{{uniqid}}-tab-toc" aria-controls="{{uniqid}}-panel-toc" aria-selected="false" tabindex="-1"
                            title="{{#str}}tab_contents, mod_leafr{{/str}}" disabled>
                        <span class="sr-only">{{#str}}tab_contents, mod_leafr{{/str}}</span>
                        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M224 128a8 8 0 0 1-8 8H40a8 8 0 0 1 0-16h176a8 8 0 0 1 8 8ZM40 72h176a8 8 0 0 0 0-16H40a8 8 0 0 0 0 16Zm176 112H40a8 8 0 0 0 0 16h176a8 8 0 0 0 0-16Z"/></svg>
                    </button>
                    {{/showtoc}}
                    <button type="button" class="leafr-sidebar-tab" role="tab" data-tab="bookmarks"
                            id="{{uniqid}}-tab-bookmarks" aria-controls="{{uniqid}}-panel-bookmarks" aria-selected="false" tabindex="-1"
                            title="{{#str}}tab_bookmarks, mod_leafr{{/str}}">
                        <span class="sr-only">{{#str}}tab_bookmarks, mod_leafr{{/str}}</span>
                        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M184 32H72a16 16 0 0 0-16 16v176a8 8 0 0 0 12.65 6.51L128 197.05l59.35 33.46A8 8 0 0 0 200 224V48a16 16 0 0 0-16-16Z"/></svg>
                    </button>
                    <button type="button" class="leafr-sidebar-tab" role="tab" data-tab="search"
                            id="{{uniqid}}-tab-search" aria-controls="{{uniqid}}-panel-search" aria-selected="false" tabindex="-1"
                            title="{{#str}}tab_search, mod_leafr{{/str}}">
                        <span class="sr-only">{{#str}}tab_search, mod_leafr{{/str}}</span>
                        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M229.66 218.34l-50.07-50.06a88.11 88.11 0 1 0-11.31 11.31l50.06 50.07a8 8 0 0 0 11.32-11.32ZM40 112a72 72 0 1 1 72 72a72.08 72.08 0 0 1-72-72Z"/></svg>
                    </button>
                </div>
                <button type="button" class="leafr-iconbtn" data-action="sidebar-close" title="{{#str}}close, mod_leafr{{/str}}">
                    <span class="sr-only">{{#str}}close, mod_leafr{{/str}}</span>
                    <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 256 256" fill="currentColor"><path d="M205.66 194.34a8 8 0 0 1-11.32 11.32L128 139.31l-66.34 66.35a8 8 0 0 1-11.32-11.32L116.69 128L50.34 61.66a8 8 0 0 1 11.32-11.32L128 116.69l66.34-66.35a8 8 0 0 1 11.32 11.32L139.31 128Z"/></svg>
                </button>
            </div>
            <div id="{{uniqid}}-panel-thumbs" class="leafr-sidebar-panel" data-panel="thumbs" data-region="thumbs" role="tabpanel" aria-labelledby="{{uniqid}}-tab-thumbs"></div>
            {{#showtoc}}
            <div id="{{uniqid}}-panel-toc" class="leafr-sidebar-panel" data-panel="toc" role="tabpanel" aria-labelledby="{{uniqid}}-tab-toc" hidden></div>
            {{/showtoc}}
            <div id="{{uniqid}}-panel-bookmarks" class="leafr-sidebar-panel" data-panel="bookmarks" role="tabpanel" aria-labelledby="{{uniqid}}-tab-bookmarks" hidden></div>
            <div id="{{uniqid}}-panel-search" class="leafr-sidebar-panel" data-panel="search" data-region="search" role="tabpanel" aria-labelledby="{{uniqid}}-tab-search" hidden></div>
        </aside>

        <div class="leafr-stage" data-region="stage" tabindex="0" aria-label="{{#str}}document, mod_leafr{{/str}}">
            <div class="leafr-loading" data-region="loading" role="status">
                <span class="leafr-spinner" aria-hidden="true"></span>
                <span>{{#str}}loading, mod_leafr{{/str}}</span>
            </div>
            <div class="leafr-error" data-region="error" role="alert" hidden>
                <p class="leafr-error-message">{{#str}}errordocument, mod_leafr{{/str}}</p>
                <div class="leafr-error-actions">
                    <button type="button" class="btn btn-primary" data-action="reload">{{#str}}reload, mod_leafr{{/str}}</button>
                    {{#downloadurl}}
                    <a class="btn btn-secondary" href="{{downloadurl}}">{{#str}}download, mod_leafr{{/str}}</a>
                    {{/downloadurl}}
                </div>
            </div>
            <div class="leafr-page-bookmarks" data-region="page-bookmarks" hidden></div>
            <div class="leafr-view" data-region="view"></div>
        </div>
    </div>

    <div class="leafr-toolbar" role="toolbar" aria-label="{{#str}}toolbar, mod_leafr{{/str}}">
        <div class="leafr-progress" data-region="progress" role="slider" tabindex="0"
             aria-label="{{#str}}pageprogress, mod_leafr{{/str}}" aria-valuemin="1" aria-valuemax="{{totalpages}}"
             aria-valuenow="{{startpage}}">
            <div class="leafr-progress-fill" data-region="progress-fill"></div>
        </div>
        <div class="leafr-progress-meta">
            <div class="leafr-progress-summary" data-region="progress-summary" aria-hidden="true"></div>
            <div class="leafr-progress-summary leafr-progress-summary-required" data-region="required-summary" aria-hidden="true" hidden></div>
        </div>
        <div class="leafr-toolbar-inner">
            <div class="leafr-toolbar-group">
                <button type="button" class="leafr-iconbtn" data-action="sidebar" aria-expanded="false" title="{{#str}}sidebar, mod_leafr{{/str}}" disabled>
                    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M216 40H40a16 16 0 0 0-16 16v144a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V56a16 16 0 0 0-16-16Zm0 16v144H96V56ZM40 56h40v144H40Z"/></svg>
                    <span class="leafr-btn-label">{{#str}}sidebar, mod_leafr{{/str}}</span>
                </button>
            </div>

            <div class="leafr-toolbar-group leafr-toolbar-nav">
                <button type="button" class="leafr-iconbtn leafr-hide-narrow" data-action="first" title="{{#str}}firstpage, mod_leafr{{/str}}" disabled>
                    <span class="sr-only">{{#str}}firstpage, mod_leafr{{/str}}</span>
                    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M205.66 202.34a8 8 0 0 1-11.32 11.32l-80-80a8 8 0 0 1 0-11.32l80-80a8 8 0 0 1 11.32 11.32L131.31 128ZM48 40a8 8 0 0 0-8 8v160a8 8 0 0 0 16 0V48a8 8 0 0 0-8-8Z"/></svg>
                </button>
                <button type="button" class="leafr-iconbtn" data-action="prev" title="{{#str}}previouspage, mod_leafr{{/str}}" disabled>
                    <span class="sr-only">{{#str}}previouspage, mod_leafr{{/str}}</span>
                    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M165.66 202.34a8 8 0 0 1-11.32 11.32l-80-80a8 8 0 0 1 0-11.32l80-80a8 8 0 0 1 11.32 11.32L91.31 128Z"/></svg>
                </button>
                <div class="leafr-pagebox">
                    <label class="sr-only" for="{{uniqid}}-page">{{#str}}gotopage, mod_leafr{{/str}}</label>
                    <input type="text" inputmode="numeric" pattern="[0-9]*" id="{{uniqid}}-page" class="leafr-pageinput"
                           data-region="page-input" value="{{startpage}}" autocomplete="off" disabled>
                    <span class="leafr-pagetotal" data-region="page-total" aria-hidden="true"></span>
                </div>
                <button type="button" class="leafr-iconbtn" data-action="next" title="{{#str}}nextpage, mod_leafr{{/str}}" disabled>
                    <span class="sr-only">{{#str}}nextpage, mod_leafr{{/str}}</span>
                    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M181.66 133.66l-80 80a8 8 0 0 1-11.32-11.32L164.69 128 90.34 53.66a8 8 0 0 1 11.32-11.32l80 80a8 8 0 0 1 0 11.32Z"/></svg>
                </button>
                <button type="button" class="leafr-iconbtn leafr-hide-narrow" data-action="last" title="{{#str}}lastpage, mod_leafr{{/str}}" disabled>
                    <span class="sr-only">{{#str}}lastpage, mod_leafr{{/str}}</span>
                    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M208 40a8 8 0 0 0-8 8v160a8 8 0 0 0 16 0V48a8 8 0 0 0-8-8ZM50.34 53.66a8 8 0 0 1 11.32-11.32l80 80a8 8 0 0 1 0 11.32l-80 80a8 8 0 0 1-11.32-11.32L124.69 128Z"/></svg>
                </button>
            </div>

            <div class="leafr-toolbar-group">
                <div class="leafr-viewmenu-wrap">
                    <button type="button" class="leafr-iconbtn" data-action="view-menu" aria-haspopup="true" aria-expanded="false" title="{{#str}}viewmenu, mod_leafr{{/str}}" disabled>
                        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M216 40H40a16 16 0 0 0-16 16v144a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V56a16 16 0 0 0-16-16Zm-96 160H40V56h80Zm96 0h-80V56h80Z"/></svg>
                        <span class="leafr-btn-label">{{#str}}viewmenu, mod_leafr{{/str}}</span>
                    </button>
                    <div class="leafr-viewmenu" data-region="view-menu" role="menu" aria-label="{{#str}}viewmenu, mod_leafr{{/str}}" hidden>
                        <div class="leafr-viewmenu-label leafr-spread-label" id="{{uniqid}}-spreadlabel">{{#str}}spreadmode, mod_leafr{{/str}}</div>
                        <div class="leafr-viewmenu-group" data-region="spread-group" role="group" aria-labelledby="{{uniqid}}-spreadlabel">
                            <button type="button" class="leafr-menuitem" role="menuitemradio" aria-checked="true" data-action="spread-auto" data-spread="auto" disabled>{{#str}}spread_auto, mod_leafr{{/str}}</button>
                            <button type="button" class="leafr-menuitem" role="menuitemradio" aria-checked="false" data-action="spread-single" data-spread="single" disabled>{{#str}}spread_single, mod_leafr{{/str}}</button>
                            <button type="button" class="leafr-menuitem" role="menuitemradio" aria-checked="false" data-action="spread-double" data-spread="double" disabled>{{#str}}spread_double, mod_leafr{{/str}}</button>
                        </div>
                        <button type="button" class="leafr-menuitem leafr-menuitem-check" role="menuitemcheckbox" data-action="simpleview" aria-checked="false" disabled>{{#str}}simpleview, mod_leafr{{/str}}</button>
                        <div class="leafr-viewmenu-label">{{#str}}zoomheading, mod_leafr{{/str}}</div>
                        <div class="leafr-viewmenu-zoom" data-region="fit-group">
                            <button type="button" class="leafr-iconbtn" data-action="zoom-out" title="{{#str}}zoomout, mod_leafr{{/str}}" disabled>
                                <span class="sr-only">{{#str}}zoomout, mod_leafr{{/str}}</span>
                                <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M152 112a8 8 0 0 1-8 8H80a8 8 0 0 1 0-16h64a8 8 0 0 1 8 8Zm77.66 117.66a8 8 0 0 1-11.32 0l-50.06-50.07a88.11 88.11 0 1 1 11.31-11.31l50.07 50.06a8 8 0 0 1 0 11.32ZM112 184a72 72 0 1 0-72-72a72.08 72.08 0 0 0 72 72Z"/></svg>
                            </button>
                            <button type="button" class="leafr-zoomlabel" data-action="zoom-reset" data-region="zoom-label" title="{{#str}}zoomreset, mod_leafr{{/str}}" disabled>100%</button>
                            <button type="button" class="leafr-iconbtn" data-action="zoom-in" title="{{#str}}zoomin, mod_leafr{{/str}}" disabled>
                                <span class="sr-only">{{#str}}zoomin, mod_leafr{{/str}}</span>
                                <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M152 112a8 8 0 0 1-8 8h-24v24a8 8 0 0 1-16 0v-24H80a8 8 0 0 1 0-16h24V80a8 8 0 0 1 16 0v24h24a8 8 0 0 1 8 8Zm77.66 117.66a8 8 0 0 1-11.32 0l-50.06-50.07a88.11 88.11 0 1 1 11.31-11.31l50.07 50.06a8 8 0 0 1 0 11.32ZM112 184a72 72 0 1 0-72-72a72.08 72.08 0 0 0 72 72Z"/></svg>
                            </button>
                        </div>
                        <div class="leafr-viewmenu-group" data-region="fitmode-group" role="group" aria-label="{{#str}}fitmode, mod_leafr{{/str}}">
                            <button type="button" class="leafr-menuitem" role="menuitemradio" aria-checked="true" data-action="fit-page" data-fit="page" disabled>{{#str}}fit_page, mod_leafr{{/str}}</button>
                            <button type="button" class="leafr-menuitem" role="menuitemradio" aria-checked="false" data-action="fit-width" data-fit="width" disabled>{{#str}}fit_width, mod_leafr{{/str}}</button>
                        </div>
                        <button type="button" class="leafr-menuitem leafr-menuitem-check" role="menuitemcheckbox" data-action="fullscreen" aria-checked="false" disabled>
                            <span data-region="fullscreen-label">{{#str}}fullscreen_enter, mod_leafr{{/str}}</span>
                        </button>
                        {{#downloadurl}}
                        <a class="btn leafr-menuitem leafr-menuitem-check leafr-menu-download" role="menuitem" href="{{downloadurl}}">{{#str}}download, mod_leafr{{/str}}</a>
                        {{/downloadurl}}
                    </div>
                </div>
                <button type="button" class="leafr-iconbtn" data-action="bookmark" aria-pressed="false" title="{{#str}}bookmark, mod_leafr{{/str}}" disabled>
                    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M184 32H72a16 16 0 0 0-16 16v176a8 8 0 0 0 12.65 6.51L128 197.05l59.35 33.46A8 8 0 0 0 200 224V48a16 16 0 0 0-16-16Z"/></svg>
                    <span class="leafr-btn-label">{{#str}}bookmark, mod_leafr{{/str}}</span>
                </button>
                {{#downloadurl}}
                <a class="leafr-iconbtn leafr-toolbar-download" href="{{downloadurl}}" title="{{#str}}download, mod_leafr{{/str}}">
                    <span class="sr-only">{{#str}}download, mod_leafr{{/str}}</span>
                    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M224 152v56a16 16 0 0 1-16 16H48a16 16 0 0 1-16-16v-56a8 8 0 0 1 16 0v56h160v-56a8 8 0 0 1 16 0Zm-101.66 5.66a8 8 0 0 0 11.32 0l40-40a8 8 0 0 0-11.32-11.32L136 132.69V40a8 8 0 0 0-16 0v92.69l-26.34-26.35a8 8 0 0 0-11.32 11.32Z"/></svg>
                </a>
                {{/downloadurl}}
                <button type="button" class="leafr-iconbtn leafr-hide-narrow" data-action="help" aria-haspopup="dialog" title="{{#str}}help, mod_leafr{{/str}}">
                    <span class="sr-only">{{#str}}help, mod_leafr{{/str}}</span>
                    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M140 180a12 12 0 1 1-12-12a12 12 0 0 1 12 12ZM128 72c-22.06 0-40 16.15-40 36v4a8 8 0 0 0 16 0v-4c0-11 10.77-20 24-20s24 9 24 20s-10.77 20-24 20a8 8 0 0 0-8 8v8a8 8 0 0 0 16 0v-.72c18.24-3.35 32-17.9 32-35.28c0-19.85-17.94-36-40-36Zm104 56A104 104 0 1 1 128 24a104.11 104.11 0 0 1 104 104Zm-16 0a88 88 0 1 0-88 88a88.1 88.1 0 0 0 88-88Z"/></svg>
                </button>
            </div>
        </div>
    </div>

    <div class="sr-only" data-region="live" aria-live="polite" aria-atomic="true"></div>
    <div class="leafr-toast leafr-toast-info" data-region="continue" role="status" hidden>
        <span data-region="continue-text"></span>
        <button type="button" class="leafr-toast-action" data-action="restart">{{#str}}restartreading, mod_leafr{{/str}}</button>
    </div>
    <div class="leafr-toast leafr-toast-info" data-region="fullscreen-tip" role="status" hidden>
        <span>{{#str}}fullscreentip, mod_leafr{{/str}}</span>
        <button type="button" class="leafr-toast-action" data-action="fullscreen-tip">{{#str}}fullscreen_enter, mod_leafr{{/str}}</button>
        <button type="button" class="leafr-toast-close" data-action="fullscreen-tip-close" title="{{#str}}close, mod_leafr{{/str}}">
            <span class="sr-only">{{#str}}close, mod_leafr{{/str}}</span>
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 256 256" fill="currentColor"><path d="M205.66 194.34a8 8 0 0 1-11.32 11.32L128 139.31l-66.34 66.35a8 8 0 0 1-11.32-11.32L116.69 128L50.34 61.66a8 8 0 0 1 11.32-11.32L128 116.69l66.34-66.35a8 8 0 0 1 11.32 11.32L139.31 128Z"/></svg>
        </button>
    </div>
    <div class="leafr-toast" data-region="completion" role="status" hidden>
        <svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M173.66 98.34a8 8 0 0 1 0 11.32l-56 56a8 8 0 0 1-11.32 0l-24-24a8 8 0 0 1 11.32-11.32L112 148.69l50.34-50.35a8 8 0 0 1 11.32 0ZM232 128A104 104 0 1 1 128 24a104.11 104.11 0 0 1 104 104Zm-16 0a88 88 0 1 0-88 88a88.1 88.1 0 0 0 88-88Z"/></svg>
        <span>{{#str}}completion_done, mod_leafr{{/str}}</span>
    </div>

    <div class="leafr-help" data-region="help" role="dialog" aria-modal="true" aria-labelledby="{{uniqid}}-help-title" hidden>
        <div class="leafr-help-dialog">
            <h2 class="leafr-help-title" id="{{uniqid}}-help-title">{{#str}}help, mod_leafr{{/str}}</h2>
            <p>{{#str}}help_intro, mod_leafr{{/str}}</p>
            <dl class="leafr-help-list">
                <dt><kbd>→</kbd> <kbd>←</kbd></dt><dd>{{#str}}help_nextprev, mod_leafr{{/str}}</dd>
                <dt><kbd>Home</kbd> <kbd>End</kbd></dt><dd>{{#str}}help_firstlast, mod_leafr{{/str}}</dd>
                <dt><kbd>+</kbd> <kbd>-</kbd></dt><dd>{{#str}}help_zoom, mod_leafr{{/str}}</dd>
                {{#showtoc}}<dt><kbd>T</kbd></dt><dd>{{#str}}help_toc, mod_leafr{{/str}}</dd>{{/showtoc}}
                <dt><kbd>B</kbd></dt><dd>{{#str}}help_bookmark, mod_leafr{{/str}}</dd>
                <dt><kbd>F</kbd></dt><dd>{{#str}}help_fullscreen, mod_leafr{{/str}}</dd>
                <dt><kbd>Esc</kbd></dt><dd>{{#str}}help_close, mod_leafr{{/str}}</dd>
                <dt><kbd>?</kbd></dt><dd>{{#str}}help_help, mod_leafr{{/str}}</dd>
            </dl>
            <button type="button" class="btn btn-primary" data-action="help-close">{{#str}}close, mod_leafr{{/str}}</button>
        </div>
    </div>
</div>
