includes:
    # PHPStan resolves "includes" paths relative to this config file's own directory
    # (.github/), not the working directory the analyser runs from - hence "../vendor/..."
    # to reach the vendor/ folder that composer installs at the plugin root.
    - ../vendor/micaherne/phpstan-moodle/extension.neon

parameters:
    level: 5
    paths:
        - .
    excludePaths:
        - vendor/*
        - amd/build/*
        - tool/*/amd/build/*
        - .github/*
    moodle:
        rootDirectory: ../moodle
        addCommonIncludes: true
    tmpDir: /tmp/phpstan-cache
