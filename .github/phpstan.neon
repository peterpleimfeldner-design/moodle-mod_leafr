includes:
    # PHPStan resolves EVERY relative path in a config file relative to that file's own
    # directory (.github/ here), never relative to the working directory the analyser is run
    # from. That applies to "includes" as well as to the "parameters" below (paths,
    # excludePaths, and the moodle extension's own rootDirectory) - each therefore needs an
    # extra "../" to reach the plugin root, which is one level above .github/.
    - ../vendor/micaherne/phpstan-moodle/extension.neon

parameters:
    level: 5
    paths:
        - ..
    excludePaths:
        - ../vendor/*
        - ../amd/build/*
        - ../tool/*/amd/build/*
        - ../.github/*
        # The classmap/basename-collision false positive documented below, for this specific file,
        # is a "return.missing" error, which PHPStan treats as non-ignorable via ignoreErrors
        # ("cannot be ignored, use excludePaths instead" - its own error message). All four methods
        # in this file clearly contain a return statement; verified by reading the file directly.
        - ../classes/local/bookmarks.php
    moodle:
        rootDirectory: ../../moodle
        addCommonIncludes: true
    tmpDir: /tmp/phpstan-cache

    # The get_objectid_mapping() false positive below (a suspected classmap/basename collision
    # while scanning the full Moodle core plugin tree) did not reproduce against a smaller local
    # Moodle install with fewer activity modules present, only in the real CI matrix. Since which
    # errors that particular quirk produces may not be identical on every Moodle branch, an ignore
    # rule that PHPStan would otherwise reject as "unmatched" on a branch where it does not trigger
    # must not fail the whole build.
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # XMLDB_INDEX_UNIQUE/XMLDB_INDEX_NOTUNIQUE are genuinely booleans in Moodle core
        # (lib/xmldb/xmldb_constants.php), but the phpstan-moodle stub types add_index()'s
        # $type parameter as int. This is how every Moodle plugin's upgrade.php calls it.
        -
            message: '~Parameter #2 \$type of method xmldb_table::add_index\(\) expects int, true given~'
            path: ../db/upgrade.php

        # False positive verified against Moodle core (lib/classes/event/course_module_viewed.php
        # and lib/classes/event/base.php): our override unconditionally returns an array, and the
        # parent declares no incompatible native return type. The identical pattern in
        # page_viewed.php (a class name unique to this plugin) is NOT flagged, only this one is -
        # course_module_viewed.php is also the basename of a same-named event class in dozens of
        # other Moodle core activity modules, which points to a classmap/basename collision in
        # phpstan-moodle's Moodle-wide class scanning rather than a real bug here.
        -
            message: '#Method mod_leafr\\event\\course_module_viewed::get_objectid_mapping\(\) should return array but return statement is missing#'
            path: ../classes/event/course_module_viewed.php

        # core_privacy\local\request\writer::with_context() returns the content_writer interface,
        # which does declare has_any_data()/get_data()/get_user_preferences() (see
        # privacy/classes/local/request/content_writer.php) - phpstan-moodle's stub does not
        # appear to resolve this interface's methods. This is the standard, documented way every
        # Moodle privacy provider test exports/asserts data.
        -
            message: '#Call to an undefined method core_privacy\\local\\request\\content_writer::(has_any_data|get_data|get_user_preferences)\(\)#'
            path: ../tests/privacy/provider_test.php

        # Same classmap/basename collision as the course_module_viewed.php entry above (a file
        # named "bookmarks.php" is common enough across Moodle core/other plugins to collide during
        # the full-tree scan), but only reproduces on the MOODLE_501_STABLE CI leg, not the others.
        # The "return statement is missing" errors themselves are excluded via excludePaths above
        # (PHPStan refuses to ignore that identifier by message). Once PHPStan mis-infers
        # bookmarks::set()'s return type as void from that, it also flags every caller that ignores
        # the return value as "no effect" - those two are ordinary ignorable errors.
        -
            message: '#Call to mod_leafr\\local\\bookmarks::set\(\) on a separate line has no effect#'
            path: ../tests/local/bookmarks_test.php
        -
            message: '#Call to mod_leafr\\local\\bookmarks::set\(\) on a separate line has no effect#'
            path: ../tests/privacy/provider_test.php

        # approved_contextlist's constructor only documents @param \int[] $contextids (no native
        # type); the literal array passed here ([$this->context->id]) is a genuine list of ints.
        -
            message: '~Parameter #3 \$contextids of class core_privacy\\local\\request\\approved_contextlist constructor expects array<int>, array<int, int> given~'
            path: ../tests/privacy/provider_test.php
