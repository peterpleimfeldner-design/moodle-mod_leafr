<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/leafr/db" VERSION="20260304" COMMENT="XMLDB file for mod_leafr"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="leafr" COMMENT="Leafr flipbook activity instances">
      <FIELDS>
        <FIELD NAME="id"                TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course"            TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"       COMMENT="FK to mdl_course.id"/>
        <FIELD NAME="name"              TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="intro"             TYPE="text"              NOTNULL="false"/>
        <FIELD NAME="introformat"       TYPE="int"  LENGTH="4"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="filearea"          TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="content" COMMENT="File API area name"/>
        <FIELD NAME="completiontype"    TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="0"       COMMENT="0=none, 1=last_page, 2=percent, 3=specific_page"/>
        <FIELD NAME="completionpercent" TYPE="int"  LENGTH="3"  NOTNULL="true" DEFAULT="100"     COMMENT="Required percent when completiontype=2"/>
        <FIELD NAME="completionpage"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"       COMMENT="Required page when completiontype=3"/>
        <FIELD NAME="downloadallowed"   TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="showtoc"           TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="initialpage"       TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="totalpages"        TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"       COMMENT="Total number of pages in the PDF"/>
        <FIELD NAME="timecreated"       TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"   TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="leafr_bookmarks" COMMENT="Pro: Named bookmarks per user per instance">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="leafrid"      TYPE="int"  LENGTH="10" NOTNULL="true"                  COMMENT="FK to mdl_leafr.id"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="true"                  COMMENT="FK to mdl_user.id"/>
        <FIELD NAME="pageno"       TYPE="int"  LENGTH="10" NOTNULL="true"                  COMMENT="1-based page number"/>
        <FIELD NAME="label"        TYPE="char" LENGTH="255" NOTNULL="true"                 COMMENT="User-defined label"/>
        <FIELD NAME="note"         TYPE="text"              NOTNULL="false"                COMMENT="Optional note (max 500 chars)"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary"  FIELDS="id"/>
        <KEY NAME="fk_leafr" TYPE="foreign"  FIELDS="leafrid" REFTABLE="leafr" REFFIELDS="id"/>
        <KEY NAME="fk_user"  TYPE="foreign"  FIELDS="userid"  REFTABLE="user"  REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="leafr_user" UNIQUE="false" FIELDS="leafrid, userid" COMMENT="Compound index for fast user-bookmark lookup"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
