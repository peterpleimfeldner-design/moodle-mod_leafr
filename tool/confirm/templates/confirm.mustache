{{!
    @template leafrtool_confirm/confirm

    The read confirmation card, shown below the reader once the reading requirement is met.
    Hidden by default; amd/src/confirm.js reveals it when it receives the core reader's
    "leafr:reading-complete" event for this activity's cmid.

    Context variables required for this template:
    * cmid - Course module id
    * text - Confirmation statement, already formatted
    * confirmed - Whether the current user already confirmed
    * donetext - Fully resolved "Confirmed on ..." text, empty if not confirmed

    Example context (json):
    {
        "cmid": 12,
        "text": "I have read and understood the contents.",
        "confirmed": false,
        "donetext": ""
    }
}}
<div class="leafrtool-confirm" data-region="leafrtool-confirm" data-cmid="{{cmid}}" hidden>
    <p class="leafrtool-confirm-text">{{text}}</p>
    <div class="leafrtool-confirm-form" data-region="form" {{#confirmed}}hidden{{/confirmed}}>
        <label class="leafrtool-confirm-checkbox">
            <input type="checkbox" data-region="checkbox">
            {{#str}}confirm_checkbox, leafrtool_confirm{{/str}}
        </label>
        <button type="button" class="btn btn-primary" data-action="confirm" disabled>
            {{#str}}confirm_button, leafrtool_confirm{{/str}}
        </button>
    </div>
    <p class="leafrtool-confirm-done" data-region="done" {{^confirmed}}hidden{{/confirmed}}>
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 256 256" fill="currentColor"><path d="M173.66 98.34a8 8 0 0 1 0 11.32l-56 56a8 8 0 0 1-11.32 0l-24-24a8 8 0 0 1 11.32-11.32L112 148.69l50.34-50.35a8 8 0 0 1 11.32 0ZM232 128A104 104 0 1 1 128 24a104.11 104.11 0 0 1 104 104Zm-16 0a88 88 0 1 0-88 88a88.1 88.1 0 0 0 88-88Z"/></svg>
        <span data-region="donetext">{{donetext}}</span>
    </p>
</div>
