<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/leafr/tool/office/db" VERSION="20260924" COMMENT="XMLDB file for Moodle leafrtool_office"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="leafrtool_office_conversion" COMMENT="Tracks background conversion of an uploaded Word/PowerPoint/ODF file to PDF">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="leafrid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="mod_leafr instance id"/>
        <FIELD NAME="sourcecontenthash" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="Content hash of the source file this conversion is for, to detect a re-upload"/>
        <FIELD NAME="status" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="pending, complete or failed"/>
        <FIELD NAME="errormessage" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_leafrid" TYPE="foreign-unique" FIELDS="leafrid" REFTABLE="leafr" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="leafrtool_office_settings" COMMENT="Per-activity settings of the Office document tool">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="leafrid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="mod_leafr instance id"/>
        <FIELD NAME="downloadoriginal" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Offer the original Office file for download instead of the converted PDF"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_leafrid" TYPE="foreign-unique" FIELDS="leafrid" REFTABLE="leafr" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
